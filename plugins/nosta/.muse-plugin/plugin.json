{
  "schemaVersion": 1,
  "name": "nosta",
  "displayName": "Nosta",
  "version": "0.5.3",
  "description": "Nosta MCP tools, prompts, engineering workflow skills, and merge-gate approval guardrails.",
  "compat": {
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "author-flow",
        "path": "skills/author-flow/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "use-flow",
        "path": "skills/use-flow/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "improve-flow",
        "path": "skills/improve-flow/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "build-artifact",
        "path": "skills/build-artifact/SKILL.md",
        "enabledDefault": true
      }
    ],
    "hooks": [
      {
        "id": "approve-guard",
        "event": "PreToolUse",
        "command": [
          "bash",
          "hooks/muse-approve-guard.sh"
        ]
      }
    ],
    "mcpServers": [
      {
        "id": "nosta",
        "transport": "stdio",
        "command": [
          "node",
          "dist/server.mjs"
        ]
      }
    ]
  }
}
